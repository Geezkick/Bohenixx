// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model ServiceRequest {
  id          String   @id @default(cuid())
  service     String
  budget      String
  timeline    String
  details     String
  email       String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(cuid())
  app         String
  action      String
  color       String
  createdAt   DateTime @default(now())
}

model Telemetry {
  id          String   @id @default(cuid())
  activeDevices Int
  bandwidth   Float
  latency     Int
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String?
  message   String
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteVisit {
  id        String   @id @default(cuid())
  ipHash    String
  country   String?
  city      String?
  createdAt DateTime @default(now())

  @@index([ipHash])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  from      String
  subject   String
  status    String   // SENT, FAILED, PENDING
  type      String   // CONTACT, SUPPORT, CAREER, ALERT, SYSTEM
  error     String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
}

model SupportTicket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique
  email        String
  subject      String
  message      String
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String   @default("NORMAL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([ticketNumber])
}

model JobApplication {
  id          String   @id @default(cuid())
  email       String
  name        String
  position    String
  portfolioUrl String?
  coverLetter String?
  status      String   @default("PENDING") // PENDING, REVIEWING, REJECTED, HIRED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
}

