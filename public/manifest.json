{
  "name": "BOHENIX ONE",
  "short_name": "Bohenix",
  "description": "The official digital ecosystem of Bohenix Technologies.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "portrait",
  "categories": ["technology", "business", "productivity"],
  "dir": "ltr",
  "lang": "en",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Store",
      "short_name": "Store",
      "description": "Browse Bohenix hardware & products",
      "url": "/store",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Request Service",
      "short_name": "Services",
      "description": "Request a technology service",
      "url": "/services/request",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "handle_links": "preferred",
  "scope_extensions": [
    { "origin": "*.vercel.app" }
  ]
}
